{
  "name": "assess-to-intervene-colleague",
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "web",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm --workspace server run dev",
    "dev:web": "npm --workspace web run dev",
    "build": "npm --workspace web run build",
    "test": "node --test server/tests/*.test.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
