# Copy to .env and fill in. Never commit .env.
PORT=3001

# Groq. Free key: https://console.groq.com, then check your model list and rate limits.
GROQ_API_KEY=
GROQ_MODEL_LARGE=openai/gpt-oss-120b
GROQ_MODEL_SMALL=openai/gpt-oss-20b

# Which provider answers first: gemini (default) or groq. The other one is the fallback.
LLM_PRIMARY=gemini

# Gemini. Free key: https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Parallel model calls during marking; lower it if you hit 429s.
CONCURRENCY=4
LLM_TIMEOUT_MS=60000
# Set to 1 to bypass the disk cache.
NO_CACHE=0

# Delivery (phase 4, Owethu): team Gmail + app password.
SMTP_USER=
SMTP_PASS=

# Run the app on the deterministic fake model (no keys needed) for UI work and demo rehearsals.
FAKE_LLM=0
FAKE_LLM_LATENCY_MS=250

# Live pitch: slow down cached answers so the warmed run unfolds on screen (about 20-30 s). 0 = full speed.
DEMO_PACE_MS=0

# Handwritten script photos (feature flag). false = the app behaves exactly as before.
# true adds a photo upload; Gemini reads each script, Groq reads it again independently, and only words
# both agree on are kept (everything else becomes [illegible]). The teacher reviews the text before marking.
FEATURE_HANDWRITING=false
GEMINI_VISION_MODEL=gemini-3.5-flash-lite
GROQ_VISION_MODEL=qwen/qwen3.8-27b
# Flag "transcription needs teacher" above this share of [illegible] words, or this much disagreement.
HANDWRITING_ILLEGIBLE_MAX=0.15
HANDWRITING_DISAGREE_MAX=0.2
