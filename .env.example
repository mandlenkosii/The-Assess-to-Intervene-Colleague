# Copy to .env and fill in. Never commit .env.
PORT=3001

# Groq (primary). Free key: https://console.groq.com, then check your model list and rate limits.
GROQ_API_KEY=
GROQ_MODEL_LARGE=llama-3.3-70b-versatile
GROQ_MODEL_SMALL=llama-3.1-8b-instant

# Gemini (fallback). Free key: https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Parallel model calls during marking; lower it if you hit 429s.
CONCURRENCY=4
LLM_TIMEOUT_MS=60000
# Set to 1 to bypass the disk cache.
NO_CACHE=0

# Delivery (phase 4, Owethu): team Gmail + app password.
SMTP_USER=
SMTP_PASS=

# Run the app on the deterministic fake model (no keys needed) for UI work and demo rehearsals.
FAKE_LLM=0
FAKE_LLM_LATENCY_MS=250
